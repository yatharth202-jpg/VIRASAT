# VIRASAT Environment Configuration Template
PORT=3000
NODE_ENV=development

# Configurable Rate Limit Thresholds
AUTH_RATE_LIMIT_IP=5
AUTH_RATE_LIMIT_ACCOUNT=3
AUTH_RATE_WINDOW_MS=60000
AUTH_BASE_BACKOFF_MS=2000
AUTH_MAX_BACKOFF_MS=64000
AUTH_BACKOFF_FACTOR=2

PUBLIC_RATE_LIMIT=30
PUBLIC_RATE_WINDOW_MS=60000

AUTHENTICATED_RATE_LIMIT=60
AUTHENTICATED_RATE_WINDOW_MS=60000

# File Upload Caps
MAX_UPLOAD_SIZE_BYTES=5242880
